{
  "expo": {
    "name": "kaitag",
    "slug": "kaitag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0b0a",
    "scheme": "kaitag",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0b0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vagabiii.kaitag",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0b0a",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.vagabiii.kaitag"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4447fefb-e7c3-425f-8dc9-fd98a5ff52eb"
      }
    }
  }
}
